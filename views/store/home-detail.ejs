<%- include('../partials/head') %></head><body class="flex min-h-screen flex-col bg-slate-50"><%- include('../partials/nav') %><main class="mx-auto w-full max-w-6xl flex-1 px-4 py-12 sm:px-6"><a href="/homes" class="text-sm font-semibold text-rose-600 hover:underline">← Back to homes</a><section class="mt-5 grid overflow-hidden rounded-3xl bg-white shadow-xl shadow-slate-900/5 lg:grid-cols-2"><img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="h-full min-h-80 w-full object-cover"/><div class="p-7 sm:p-10"><p class="text-sm text-slate-500"><%= home.location %></p><h1 class="mt-2 text-3xl font-bold text-slate-900"><%= home.houseName %></h1><div class="mt-5 flex gap-4 text-sm"><span class="rounded-full bg-amber-50 px-3 py-1 font-semibold text-amber-700">★ <%= home.rating %> / 5</span><span class="rounded-full bg-rose-50 px-3 py-1 font-semibold text-rose-700">Rs <%= home.price %> / night</span></div><div class="mt-8 border-t pt-6"><h2 class="font-bold text-slate-900">About this home</h2><p class="mt-3 leading-7 text-slate-600"><%= home.description %></p></div><div class="mt-8"><%- include('../partials/favourite', { home: home }) %></div></div></section></main><%- include('../partials/footer') %></body></html>
