<%- include('../partials/head') %>
</head>
<body class="flex min-h-screen flex-col bg-slate-50">
  <%- include('../partials/nav') %>

  <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-12 sm:px-6">
    <div class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-[.16em] text-rose-500">Your shortlist</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-900">Saved favourites</h1>
    </div>

    <% if (registeredHomes.length) { %>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% registeredHomes.forEach(home => { %>
          <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="h-56 w-full object-cover" />
            <div class="p-5">
              <p class="text-sm text-slate-500"><%= home.location %></p>
              <h2 class="mt-1 text-xl font-bold"><%= home.houseName %></h2>
              <p class="mt-3 font-semibold">Rs <%= home.price %> <span class="font-normal text-slate-500">/ night · ★ <%= home.rating %></span></p>
              <div class="mt-5 flex gap-3">
                <a href="/homes/<%= home._id %>" class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white">View stay</a>
                <form action="/favourites/delete/<%= home._id %>" method="POST">
                  <button class="rounded-lg border border-rose-200 px-3 py-2 text-sm font-semibold text-rose-600 hover:bg-rose-50">Remove</button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="rounded-3xl bg-white p-12 text-center shadow-sm">
        <h2 class="text-2xl font-bold">No favourites yet</h2>
        <p class="mt-2 text-slate-600">Save homes you love to find them quickly later.</p>
        <a href="/homes" class="mt-6 inline-block rounded-xl bg-rose-500 px-5 py-3 font-semibold text-white">Browse homes</a>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
