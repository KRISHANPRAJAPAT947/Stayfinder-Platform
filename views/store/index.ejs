<%- include('../partials/head') %>
</head>
<body class="flex min-h-screen flex-col bg-slate-50 text-slate-800">
  <%- include('../partials/nav') %>

  <main class="flex-1">
    <section class="overflow-hidden bg-gradient-to-br from-rose-50 via-white to-orange-50">
      <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_.9fr] lg:px-8 lg:py-24">
        <div>
          <p class="mb-4 inline-flex rounded-full bg-rose-100 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-rose-700">Stay made simple</p>
          <h1 class="max-w-2xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">Find a place that feels like <span class="text-rose-500">home.</span></h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">Stayfinder brings together comfortable homes and thoughtful hosts, so guests can book with confidence and enjoy every moment away.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#featured-stays" class="rounded-xl bg-rose-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-rose-500/25 transition hover:bg-rose-600 focus:outline-none focus:ring-4 focus:ring-rose-200">Explore stays</a>
            <% if (!isLoggedIn) { %>
              <a href="/signup" class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-rose-200 hover:bg-rose-50">Create an account</a>
            <% } %>
          </div>
          <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-slate-600">
            <span class="flex items-center gap-2"><span class="grid h-5 w-5 place-items-center rounded-full bg-emerald-100 text-xs text-emerald-700">✓</span>Easy booking</span>
            <span class="flex items-center gap-2"><span class="grid h-5 w-5 place-items-center rounded-full bg-emerald-100 text-xs text-emerald-700">✓</span>Trusted homes</span>
            <span class="flex items-center gap-2"><span class="grid h-5 w-5 place-items-center rounded-full bg-emerald-100 text-xs text-emerald-700">✓</span>Guest support</span>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="absolute -inset-4 -rotate-3 rounded-[2rem] bg-rose-200/50"></div>
          <div class="relative rounded-[2rem] bg-slate-900 p-7 text-white shadow-2xl shadow-slate-900/20 sm:p-9">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-300">Guest promise</p>
            <h2 class="mt-4 text-3xl font-bold leading-tight">More than a booking, a better stay.</h2>
            <div class="mt-8 space-y-5">
              <div class="flex gap-4">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/10 text-rose-300">01</span>
                <div>
                  <h3 class="font-semibold">Discover your fit</h3>
                  <p class="mt-1 text-sm leading-6 text-slate-300">Browse homes that match your trip, budget, and style.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/10 text-rose-300">02</span>
                <div>
                  <h3 class="font-semibold">Book with clarity</h3>
                  <p class="mt-1 text-sm leading-6 text-slate-300">See the key details before you reserve your stay.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/10 text-rose-300">03</span>
                <div>
                  <h3 class="font-semibold">Travel comfortably</h3>
                  <p class="mt-1 text-sm leading-6 text-slate-300">Save favourites and keep your travel plans in one place.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="featured-stays" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-rose-500">Handpicked for you</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Featured stays</h2>
        </div>
        <a href="/homes" class="text-sm font-semibold text-rose-600 hover:text-rose-700 hover:underline">View all homes <span aria-hidden="true">→</span></a>
      </div>
      <% if (registeredHomes.length > 0) { %>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% registeredHomes.forEach(home => { %>
            <article class="group overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/10">
              <div class="relative overflow-hidden">
                <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="h-56 w-full object-cover transition duration-500 group-hover:scale-105" />
                <span class="absolute right-3 top-3 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-slate-700 shadow-sm">★ <%= home.rating %></span>
              </div>
              <div class="p-5">
                <p class="text-sm text-slate-500"><%= home.location %></p>
                <h3 class="mt-1 truncate text-lg font-bold text-slate-900"><%= home.houseName %></h3>
                <div class="mt-5 flex items-center justify-between gap-3">
                  <span class="text-sm font-medium text-slate-600"><strong class="text-lg text-slate-900">Rs <%= home.price %></strong> / night</span>
                  <a href="/homes/<%= home._id %>" class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-rose-500">View stay</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
          <p class="text-lg font-semibold text-slate-800">New stays are on their way.</p>
          <p class="mt-2 text-sm text-slate-500">Please check back soon to find your next home away from home.</p>
        </div>
      <% } %>
    </section>

    <section id="guest-guide" class="border-y border-rose-100 bg-rose-50/60">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-rose-500">For every guest</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Everything you need for a smooth stay.</h2>
          <p class="mt-3 text-slate-600">From saving options to planning your booking, Stayfinder keeps the essentials simple.</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <div class="rounded-2xl bg-white p-6 shadow-sm">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-rose-100 text-lg text-rose-600">♡</span>
            <h3 class="mt-5 font-bold text-slate-900">Save your favourites</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Keep the homes you love in one easy-to-find list.</p>
          </div>
          <div class="rounded-2xl bg-white p-6 shadow-sm">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-rose-100 text-lg text-rose-600">⌂</span>
            <h3 class="mt-5 font-bold text-slate-900">Review stay details</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Check location, nightly price, and guest ratings before deciding.</p>
          </div>
          <div class="rounded-2xl bg-white p-6 shadow-sm">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-rose-100 text-lg text-rose-600">?</span>
            <h3 class="mt-5 font-bold text-slate-900">We're here to help</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">Need assistance? Reach our guest support team whenever you need it.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
