<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>airbnb homepage</title>
  <link href="./output.css" rel="stylesheet">
</head>
<body>
  <header>
    <h1 class="text-2xl text-red-500">Here are our registered homes</h1>
  </header>
  <main>
    <a href = "/host/add-home">add home</a>
    <ul>
      <% homes.forEach(home => { %>
        <li><div>
          <h2 class="text-xl text-green-500"><%= home.hauseName %></h2>
          <p>price per night : <%= home.price %></p>
          <p>location : <%= home.location %></p>
          <p>rating : <%= home.rating %></p>
          <img src = "<%= home.image %>" alt = "home image" />
        </div></li>
      <% }) %>
    </ul>
  </main>
</body>
</html>