<%- include('../partials/head') %></head><body class="flex min-h-screen flex-col bg-slate-50"><%- include('../partials/nav') %><main class="mx-auto w-full max-w-7xl flex-1 px-4 py-12 sm:px-6"><div class="mb-8 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-semibold uppercase tracking-[.16em] text-rose-500">Host dashboard</p><h1 class="mt-2 text-3xl font-bold text-slate-900">Your listed homes</h1></div><a href="/host/add-home" class="rounded-xl bg-rose-500 px-4 py-3 text-sm font-semibold text-white hover:bg-rose-600">+ Add a home</a></div><% if (registeredHomes.length) { %><div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"><% registeredHomes.forEach(home => { %><article class="overflow-hidden rounded-2xl bg-white shadow-sm"><img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="h-52 w-full object-cover"/><div class="p-5"><p class="text-sm text-slate-500"><%= home.location %></p><h2 class="mt-1 text-xl font-bold"><%= home.houseName %></h2><p class="mt-3 text-sm"><span class="font-semibold">Rs <%= home.price %> / night</span> · <span class="text-amber-500">★ <%= home.rating %></span></p><div class="mt-5 flex gap-3"><a href="/host/edit-home/<%= home._id %>?editing=true" class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700">Edit</a><form action="/host/delete-home/<%= home._id %>" method="POST"><button class="rounded-lg border border-rose-200 px-3 py-2 text-sm font-semibold text-rose-600 hover:bg-rose-50">Delete</button></form></div></div></article><% }) %></div><% } else { %><div class="rounded-3xl bg-white p-12 text-center shadow-sm"><h2 class="text-2xl font-bold">List your first home</h2><p class="mt-2 text-slate-600">Share your space with guests looking for a great stay.</p><a href="/host/add-home" class="mt-6 inline-block rounded-xl bg-rose-500 px-5 py-3 font-semibold text-white">Add a home</a></div><% } %></main><%- include('../partials/footer') %></body></html>
