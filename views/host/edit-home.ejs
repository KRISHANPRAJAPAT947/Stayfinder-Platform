<%- include('../partials/head') %></head><body class="flex min-h-screen flex-col bg-slate-50"><%- include('../partials/nav') %><main class="mx-auto w-full max-w-3xl flex-1 px-4 py-12"><section class="rounded-3xl bg-white p-6 shadow-xl shadow-slate-900/5 sm:p-10"><p class="text-sm font-semibold uppercase tracking-[.16em] text-rose-500">Host dashboard</p><h1 class="mt-2 text-3xl font-bold text-slate-900"><%= editing ? 'Edit your home' : 'List your home' %></h1><p class="mt-2 text-slate-500">Share the essential details guests need before booking.</p><form action="/host/<%= editing ? 'edit-home/' : 'add-home' %>" method="POST" class="mt-8 grid gap-5 sm:grid-cols-2"><input type="hidden" name="id" value="<%= editing ? home._id : '' %>"/><% const fieldClass = 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-rose-500 focus:ring-4 focus:ring-rose-100'; %><div><label class="mb-2 block text-sm font-medium">Home name</label><input name="houseName" value="<%= editing ? home.houseName : '' %>" required class="<%= fieldClass %>"/></div><div><label class="mb-2 block text-sm font-medium">Price per night</label><input type="number" name="price" value="<%= editing ? home.price : '' %>" required class="<%= fieldClass %>"/></div><div><label class="mb-2 block text-sm font-medium">Location</label><input name="location" value="<%= editing ? home.location : '' %>" required class="<%= fieldClass %>"/></div><div><label class="mb-2 block text-sm font-medium">Rating</label><input type="number" step="0.1" min="0" max="5" name="rating" value="<%= editing ? home.rating : '' %>" required class="<%= fieldClass %>"/></div><div class="sm:col-span-2"><label class="mb-2 block text-sm font-medium">Photo URL</label><input type="url" name="photoUrl" value="<%= editing ? home.photoUrl : '' %>" required class="<%= fieldClass %>"/></div><div class="sm:col-span-2"><label class="mb-2 block text-sm font-medium">Description</label><textarea name="description" rows="5" required class="<%= fieldClass %>"><%= editing ? home.description : '' %></textarea></div><button class="sm:col-span-2 rounded-xl bg-rose-500 py-3 font-semibold text-white hover:bg-rose-600"><%= editing ? 'Update home' : 'Publish home' %></button></form></section></main><%- include('../partials/footer') %></body></html>
