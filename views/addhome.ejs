<%- include('partials/header') %>
</head>
<body>
  <header>
    <h1>add your home to airbnb</h1>
  </header>
  <main>
    <form action = "/host/add-home" method = "POST">
    <input type = "text" name = hauseName placeholder = "enter your home name" />
    <input type = "text" name = price placeholder = "enter price per night" />
    <input type = "text" name = location placeholder = "enter your home location" />
    <input type = "text" name = rating placeholder = "enter your  rating" />
    <input type = "text" name = image placeholder = "enter image URL" />
    <input type = "submit" />
    </form>
  </main>
  
</body>
</html>