<%- include('../partials/head') %>
</head>
<body class="flex min-h-screen flex-col bg-gradient-to-br from-rose-50 via-white to-orange-50">
  <%- include('../partials/nav') %>

  <main class="mx-auto flex w-full max-w-5xl flex-1 items-center px-4 py-12">
    <section class="mx-auto grid w-full max-w-4xl overflow-hidden rounded-3xl bg-white shadow-2xl shadow-rose-900/10 md:grid-cols-2">
      <div class="hidden bg-rose-500 p-10 text-white md:block">
        <p class="text-sm font-semibold uppercase tracking-[.2em] text-rose-100">Welcome back</p>
        <h1 class="mt-5 text-4xl font-bold leading-tight">Your next stay is waiting.</h1>
        <p class="mt-5 leading-7 text-rose-100">View bookings, save favourites, and manage your stays.</p>
      </div>
      <div class="p-8 sm:p-10">
        <h2 class="text-3xl font-bold text-slate-900">Log in</h2>
        <p class="mt-2 text-sm text-slate-500">Welcome back to Stayfinder.</p>
        <form action="/login" method="POST" class="mt-8 space-y-5">
          <%- include('../partials/error') %>
          <div>
            <label for="username" class="mb-2 block text-sm font-medium">Email</label>
            <input id="username" type="email" name="email" value="<%= oldInput.email || '' %>" autocomplete="username" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-rose-500 focus:ring-4 focus:ring-rose-100" />
          </div>
          <div>
            <label for="password" class="mb-2 block text-sm font-medium">Password</label>
            <input id="password" type="password" name="password" autocomplete="current-password" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-rose-500 focus:ring-4 focus:ring-rose-100" />
          </div>
          <button class="w-full rounded-xl bg-rose-500 py-3 font-semibold text-white shadow-lg shadow-rose-500/25 hover:bg-rose-600">Log in</button>
        </form>
        <p class="mt-6 text-center text-sm text-slate-500">New here? <a href="/signup" class="font-semibold text-rose-600 hover:underline">Create an account</a></p>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
